{
  "version": 1,
  "cli": { "analytics": false },
  "projects": {
    "todos": {
      "projectType": "application",
      "root": "",
      "sourceRoot": "src",
      "architect": {
        "build": {
          "builder": "@loozo/angular-launch:application",
          "options": {
            "tsconfig": "tsconfig.app.json",
            "scanDirectories": ["src/routes"],
            "outDirectory": "generated",
            "tanstackQuery": true,
            "browser": "src/main.ts",
            "server": "src/main.server.ts",
            "ssr": { "entry": "src/server.ts" },
            "outputMode": "server",
            "index": "src/index.html",
            "tsConfig": "tsconfig.app.json",
            "outputPath": "dist/todos",
            "optimization": { "scripts": true, "styles": true, "fonts": false },
            "sourceMap": false,
            "statsJson": true,
            "security": { "allowedHosts": ["127.0.0.1", "localhost"] }
          },
          "configurations": {
            "check": { "check": true },
            "verification": {
              "outputPath": "dist/todos",
              "fileReplacements": [{ "replace": "src/main.ts", "with": "src/main.verification.ts" }]
            },
            "prerender": {
              "outputPath": "dist/prerender",
              "fileReplacements": [
                { "replace": "src/rendering.ts", "with": "src/rendering.prerender.ts" }
              ]
            },
            "prerender-signed-in": {
              "outputPath": "dist/prerender-signed-in",
              "fileReplacements": [
                { "replace": "src/rendering.ts", "with": "src/rendering.signed-in.ts" }
              ]
            }
          }
        },
        "serve": {
          "builder": "@loozo/angular-launch:serve",
          "options": { "buildTarget": "todos:build" }
        }
      }
    }
  }
}
