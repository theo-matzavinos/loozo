{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "skipLibCheck": true,
    "experimentalDecorators": true,
    "lib": ["ES2024", "DOM"],
    "types": ["node"],
    "outDir": "out-tsc"
  },
  "angularCompilerOptions": { "strictTemplates": true },
  "include": ["src/**/*.ts", "generated/**/*.ts"]
}
