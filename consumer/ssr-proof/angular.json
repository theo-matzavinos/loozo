{
  "version": 1,
  "cli": { "analytics": false },
  "projects": {
    "proof": {
      "projectType": "application",
      "root": "",
      "sourceRoot": "src",
      "architect": {
        "build": {
          "builder": "@loozo/angular-router:application",
          "options": {
            "tsconfig": "tsconfig.routes.json",
            "scanDirectories": ["src/routes"],
            "outDirectory": "generated",
            "delegateTarget": "proof:official:production"
          },
          "configurations": { "ci": { "check": true } }
        },
        "official": {
          "builder": "@angular/build:application",
          "options": {
            "browser": "src/main.ts",
            "server": "src/main.server.ts",
            "ssr": { "entry": "src/server.ts" },
            "outputMode": "server",
            "index": "src/index.html",
            "tsConfig": "tsconfig.app.json",
            "outputPath": "dist/proof",
            "styles": ["src/styles.css"],
            "optimization": { "scripts": true, "styles": true, "fonts": false },
            "sourceMap": false,
            "statsJson": true,
            "security": { "allowedHosts": ["127.0.0.1", "localhost"] }
          },
          "configurations": {
            "production": {},
            "development": {
              "optimization": { "scripts": false, "styles": false, "fonts": false },
              "sourceMap": true
            }
          },
          "defaultConfiguration": "production"
        },
        "serve": {
          "builder": "@loozo/angular-router:serve",
          "options": {
            "tsconfig": "tsconfig.routes.json",
            "scanDirectories": ["src/routes"],
            "outDirectory": "generated",
            "delegateTarget": "proof:official-serve"
          }
        },
        "official-serve": {
          "builder": "@angular/build:dev-server",
          "options": {
            "buildTarget": "proof:official:development",
            "host": "127.0.0.1",
            "port": 0
          }
        }
      }
    }
  }
}
