{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "skipLibCheck": false,
    "experimentalDecorators": true,
    "lib": ["ES2022", "DOM"],
    "types": ["node"],
    "outDir": "./out-tsc/app"
  },
  "angularCompilerOptions": { "strictTemplates": true },
  "files": ["src/main.ts", "src/main.server.ts", "src/server.ts"],
  "include": ["src/**/*.ts", "generated/**/*.ts"]
}
