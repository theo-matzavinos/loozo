{
  "name": "@loozo/fold-ui",
  "version": "0.0.0",
  "description": "Styled Angular components over Origami primitives, copied into your app by schematics and themed with Tailwind CSS v4.",
  "bugs": "https://github.com/theo-matzavinos/loozo/issues",
  "license": "MIT",
  "author": "Theophilos Matzavinos",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/theo-matzavinos/loozo.git",
    "directory": "packages/fold-ui"
  },
  "type": "module",
  "exports": {
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.json && node scripts/copy-assets.mjs && node ../../scripts/finish-package.mjs .",
    "prepublishOnly": "echo \"Publish from dist/: pnpm build, then pnpm --dir dist publish\" >&2 && exit 1",
    "check": "vp check",
    "typecheck": "tsc -p tsconfig.json --noEmit && ngc -p tsconfig.components.json --noEmit",
    "test": "pnpm run typecheck && pnpm run build && node --test tests/*.test.mjs",
    "test:consumer": "node tests/consumer.mjs"
  },
  "dependencies": {
    "@angular-devkit/schematics": "^22.2.2",
    "@schematics/angular": "^22.2.2"
  },
  "devDependencies": {
    "@angular/cli": "22.2.2",
    "@angular/common": "22.2.2",
    "@angular/compiler": "22.2.2",
    "@angular/compiler-cli": "22.2.2",
    "@angular/core": "22.2.2",
    "@angular/platform-browser": "22.2.2",
    "@fontsource-variable/hanken-grotesk": "5.3.0",
    "@loozo/origami-ui": "workspace:*",
    "@lucide/angular": "1.62.0",
    "@types/node": "24.13.3",
    "playwright": "1.63.0",
    "rxjs": "7.8.2",
    "tailwind-variants": "3.3.1",
    "typescript": "6.0.3",
    "vite": "npm:@voidzero-dev/vite-plus-core@0.2.5",
    "vite-plus": "0.2.5"
  },
  "ng-add": {
    "save": "devDependencies"
  },
  "schematics": "./schematics/collection.json"
}
