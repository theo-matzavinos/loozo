{
  "$schema": "http://json-schema.org/draft-07/schema",
  "$id": "FoldNgAdd",
  "title": "Set up fold",
  "type": "object",
  "properties": {
    "project": {
      "description": "The application to set up.",
      "type": "string",
      "$default": { "$source": "projectName" }
    },
    "prefix": {
      "description": "Selector prefix of the components `add` copies, such as `fold` for `foldButton`.",
      "type": "string",
      "pattern": "^[a-z][a-z0-9]*$",
      "default": "fold",
      "x-prompt": "Selector prefix for fold components:"
    }
  }
}
