{
  "compilerOptions": {
    "target": "ES2022",
    "module": "preserve",
    "moduleResolution": "bundler",
    "lib": ["ES2022", "DOM"],
    "strict": true,
    "isolatedModules": true,
    "skipLibCheck": true,
    "noImplicitOverride": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    "types": [],
    "noEmit": true,
    "paths": {
      "@loozo/origami-ui/accordion": ["../origami-ui/accordion/src/public-api.ts"],
      "@loozo/origami-ui/avatar": ["../origami-ui/avatar/src/public-api.ts"],
      "@loozo/origami-ui/button": ["../origami-ui/button/src/public-api.ts"],
      "@loozo/origami-ui/calendar": ["../origami-ui/calendar/src/public-api.ts"],
      "@loozo/origami-ui/checkbox": ["../origami-ui/checkbox/src/public-api.ts"],
      "@loozo/origami-ui/collapsible": ["../origami-ui/collapsible/src/public-api.ts"],
      "@loozo/origami-ui/collection": ["../origami-ui/collection/src/public-api.ts"],
      "@loozo/origami-ui/combobox": ["../origami-ui/combobox/src/public-api.ts"],
      "@loozo/origami-ui/date-field": ["../origami-ui/date-field/src/public-api.ts"],
      "@loozo/origami-ui/date-picker": ["../origami-ui/date-picker/src/public-api.ts"],
      "@loozo/origami-ui/dialog": ["../origami-ui/dialog/src/public-api.ts"],
      "@loozo/origami-ui/field": ["../origami-ui/field/src/public-api.ts"],
      "@loozo/origami-ui/file-field": ["../origami-ui/file-field/src/public-api.ts"],
      "@loozo/origami-ui/menu": ["../origami-ui/menu/src/public-api.ts"],
      "@loozo/origami-ui/meter": ["../origami-ui/meter/src/public-api.ts"],
      "@loozo/origami-ui/number-field": ["../origami-ui/number-field/src/public-api.ts"],
      "@loozo/origami-ui/otp-field": ["../origami-ui/otp-field/src/public-api.ts"],
      "@loozo/origami-ui/utils": ["../origami-ui/utils/src/public-api.ts"],
      "@loozo/origami-ui/popover": ["../origami-ui/popover/src/public-api.ts"],
      "@loozo/origami-ui/presence": ["../origami-ui/presence/src/public-api.ts"],
      "@loozo/origami-ui/progress": ["../origami-ui/progress/src/public-api.ts"],
      "@loozo/origami-ui/query-field": ["../origami-ui/query-field/src/public-api.ts"],
      "@loozo/origami-ui/radio-group": ["../origami-ui/radio-group/src/public-api.ts"],
      "@loozo/origami-ui/scroll-area": ["../origami-ui/scroll-area/src/public-api.ts"],
      "@loozo/origami-ui/select": ["../origami-ui/select/src/public-api.ts"],
      "@loozo/origami-ui/slider": ["../origami-ui/slider/src/public-api.ts"],
      "@loozo/origami-ui/switch": ["../origami-ui/switch/src/public-api.ts"],
      "@loozo/origami-ui/tabs": ["../origami-ui/tabs/src/public-api.ts"],
      "@loozo/origami-ui/toast": ["../origami-ui/toast/src/public-api.ts"],
      "@loozo/origami-ui/toggle": ["../origami-ui/toggle/src/public-api.ts"],
      "@loozo/origami-ui/toggle-group": ["../origami-ui/toggle-group/src/public-api.ts"],
      "@loozo/origami-ui/toolbar": ["../origami-ui/toolbar/src/public-api.ts"],
      "@loozo/origami-ui/tooltip": ["../origami-ui/tooltip/src/public-api.ts"]
