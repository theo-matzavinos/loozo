{
  "compilerOptions": {
    "target": "ES2022",
    "module": "preserve",
    "moduleResolution": "bundler",
    "lib": ["ES2022", "DOM"],
    "strict": true,
    "isolatedModules": true,
    "skipLibCheck": true,
    "noImplicitOverride": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    "types": [],
    "noEmit": true,
    "paths": {
      "@loozo/origami-ui/button": ["../origami-ui/button/src/public-api.ts"],
      "@loozo/origami-ui/checkbox": ["../origami-ui/checkbox/src/public-api.ts"],
      "@loozo/origami-ui/collection": ["../origami-ui/collection/src/public-api.ts"],
      "@loozo/origami-ui/combobox": ["../origami-ui/combobox/src/public-api.ts"],
      "@loozo/origami-ui/dialog": ["../origami-ui/dialog/src/public-api.ts"],
      "@loozo/origami-ui/field": ["../origami-ui/field/src/public-api.ts"],
      "@loozo/origami-ui/number-field": ["../origami-ui/number-field/src/public-api.ts"],
      "@loozo/origami-ui/utils": ["../origami-ui/utils/src/public-api.ts"],
      "@loozo/origami-ui/popover": ["../origami-ui/popover/src/public-api.ts"],
      "@loozo/origami-ui/presence": ["../origami-ui/presence/src/public-api.ts"],
      "@loozo/origami-ui/radio-group": ["../origami-ui/radio-group/src/public-api.ts"],
      "@loozo/origami-ui/select": ["../origami-ui/select/src/public-api.ts"],
      "@loozo/origami-ui/slider": ["../origami-ui/slider/src/public-api.ts"],
      "@loozo/origami-ui/switch": ["../origami-ui/switch/src/public-api.ts"],
      "@loozo/origami-ui/tabs": ["../origami-ui/tabs/src/public-api.ts"],
      "@loozo/origami-ui/tooltip": ["../origami-ui/tooltip/src/public-api.ts"]
    }
  },
  "angularCompilerOptions": {
    "strictInjectionParameters": true,
    "strictInputAccessModifiers": true,
    "strictTemplates": true
  },
  "include": ["components/**/*.ts"]
}
