{
  "$comment": "Router options merged into schemas/application.json by builder-schemas.mjs.",
  "properties": {
    "tsconfig": {
      "type": "string",
      "minLength": 1
    },
    "scanDirectories": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "autoDefineRoutes": {
      "$comment": "Omitted enables filesystem route definitions with route.ts; false selects explicit authoring.",
      "anyOf": [
        {
          "type": "boolean",
          "const": false
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "filename": {
              "type": "string",
              "pattern": "^[A-Za-z0-9_$][A-Za-z0-9_$.-]*\\.ts$",
              "not": {
                "anyOf": [
                  {
                    "pattern": "\\.d\\.ts$"
                  },
                  {
                    "enum": [
                      "route.generated.ts",
                      "routes.generated.ts",
                      "destinations.generated.ts"
                    ]
                  }
                ]
              }
            }
          }
        }
      ]
    },
    "outDirectory": {
      "type": "string",
      "minLength": 1
    },
    "check": {
      "type": "boolean",
      "default": false
    }
  },
  "required": ["tsconfig", "scanDirectories", "outDirectory"]
}
