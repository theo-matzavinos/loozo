{
  "$schema": "http://json-schema.org/draft-07/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["tsconfig", "scanDirectories", "outDirectory", "delegateTarget"],
  "properties": {
    "tsconfig": { "type": "string", "minLength": 1 },
    "scanDirectories": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    },
    "outDirectory": { "type": "string", "minLength": 1 },
    "delegateTarget": { "type": "string", "minLength": 1 },
    "check": { "type": "boolean", "default": false }
  }
}
