{
  "$schema": "http://json-schema.org/draft-07/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["tsconfig", "scanDirectories", "outDirectory", "delegateTarget"],
  "properties": {
    "tsconfig": { "type": "string", "minLength": 1 },
    "scanDirectories": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1,
      "items": { "type": "string", "minLength": 1 }
    },
    "autoDefineRoutes": {
      "$comment": "Conditional validation prevents Angular addUndefinedDefaults from creating an omitted opt-in object.",
      "if": true,
      "then": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "filename": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_$][A-Za-z0-9_$.-]*\\.ts$",
            "not": {
              "anyOf": [
                { "pattern": "\\.d\\.ts$" },
                {
                  "enum": ["route.generated.ts", "routes.generated.ts", "destinations.generated.ts"]
                }
              ]
            }
          }
        }
      }
    },
    "outDirectory": { "type": "string", "minLength": 1 },
    "delegateTarget": { "type": "string", "minLength": 1 }
  }
}
