{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "skipLibCheck": true,
    "experimentalDecorators": true,
    "lib": ["ES2024", "DOM"],
    "types": [],
    "noEmit": true,
    "paths": { "@loozo/angular-router/_core": ["./_core/src/index.ts"] }
  },
  "include": ["src/index.ts", "_core/src/**/*.ts", "_generated/src/**/*.ts"]
}
