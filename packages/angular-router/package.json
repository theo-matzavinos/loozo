{
  "name": "@loozo/angular-router",
  "version": "0.0.3",
  "description": "Typed route declarations, URLs, navigation and route handles for Angular's native router.",
  "bugs": "https://github.com/theo-matzavinos/loozo/issues",
  "license": "MIT",
  "author": "Theophilos Matzavinos",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/theo-matzavinos/loozo.git",
    "directory": "packages/angular-router"
  },
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/types/loozo-angular-router.d.ts",
      "default": "./dist/fesm2022/loozo-angular-router.mjs"
    },
    "./_core": {
      "types": "./dist/types/loozo-angular-router-_core.d.ts",
      "default": "./dist/fesm2022/loozo-angular-router-_core.mjs"
    },
    "./_generated": {
      "types": "./dist/types/loozo-angular-router-_generated.d.ts",
      "default": "./dist/fesm2022/loozo-angular-router-_generated.mjs"
    },
    "./_generation": {
      "types": "./node/src/generation/index.d.ts",
      "node": "./node/src/generation/index.js"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "build": "node scripts/builder-schemas.mjs && rm -rf node && tsc -p tsconfig.node.json && tsc -p src/generation/tsconfig.json && ng-packagr -p ng-package.json -c tsconfig.build.json && node ../../scripts/finish-package.mjs .",
    "prepublishOnly": "echo \"Publish from dist/: pnpm build, then pnpm --dir dist publish\" >&2 && exit 1",
    "check": "vp check",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.node.json --noEmit",
    "test": "pnpm run test:root && pnpm run test:docs && pnpm run test:schema && pnpm run snippets:check",
    "test:root": "node --test tests/root.test.mjs",
    "test:docs": "node --test tests/documentation.test.mjs",
    "test:schema": "node --test tests/schema.test.mjs",
    "snippets:check": "node scripts/snippets.mjs && ngc -p snippets/tsconfig.app.json --noEmit",
    "snippets:generate": "node scripts/snippets.mjs --write",
    "example:build": "pnpm --dir ../../examples/angular-router run build",
    "example:check": "pnpm --dir ../../examples/angular-router run check",
    "example:serve": "pnpm --dir ../../examples/angular-router run serve",
    "test:application": "node tests/application.mjs",
    "test:filesystem": "node tests/filesystem.mjs",
    "test:navigation": "node tests/navigation.mjs",
    "test:lifecycle": "node tests/lifecycle.mjs",
    "test:ssr": "node tests/ssr.mjs",
    "typecheck:consumers": "tsc -p tests/tsconfig.nodenext.json && tsc -p tests/tsconfig.bundler.json"
  },
  "dependencies": {
    "@angular-devkit/architect": "0.2202.2",
    "chokidar": "5.0.0",
    "rxjs": "7.8.2",
    "tslib": "2.8.1",
    "typescript": "6.0.3"
  },
  "devDependencies": {
    "@angular/build": "22.2.2",
    "@angular/cli": "22.2.2",
    "@angular/common": "22.2.2",
    "@angular/compiler": "22.2.2",
    "@angular/compiler-cli": "22.2.2",
    "@angular/core": "22.2.2",
    "@angular/platform-browser": "22.2.2",
    "@angular/platform-server": "22.2.2",
    "@angular/router": "22.2.2",
    "@angular/ssr": "22.2.2",
    "@types/node": "24.13.3",
    "happy-dom": "20.13.2",
    "ng-packagr": "22.2.4",
    "playwright": "1.63.0",
    "vite": "npm:@voidzero-dev/vite-plus-core@0.2.5",
    "vite-plus": "0.2.5"
  },
  "peerDependencies": {
    "@angular/build": "~22.2.0",
    "@angular/core": "^22.0.0",
    "@angular/router": "^22.0.0"
  },
  "builders": "./builders.json"
}
