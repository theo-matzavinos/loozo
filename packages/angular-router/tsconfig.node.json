{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "rootDir": ".",
    "outDir": "node",
    "strict": true,
    "skipLibCheck": true,
    "lib": ["ES2024"],
    "types": ["node"]
  },
  "include": ["src/generation/**/*.ts", "src/builders/**/*.ts"]
}
