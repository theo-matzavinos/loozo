{
  "name": "@loozo/angular-launch",
  "version": "0.1.0",
  "description": "Typed queries, mutations and declared errors on Angular's native router, HTTP and SSR pipeline.",
  "bugs": "https://github.com/theo-matzavinos/loozo/issues",
  "license": "MIT",
  "author": "Theophilos Matzavinos",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/theo-matzavinos/loozo.git",
    "directory": "packages/angular-launch"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./server": {
      "types": "./dist/server/index.d.ts",
      "default": "./dist/server/index.js"
    },
    "./_server": {
      "types": "./dist/server/generated.d.ts",
      "default": "./dist/server/generated.js"
    },
    "./_route": {
      "types": "./dist/route-spec.d.ts",
      "default": "./dist/route-spec.js"
    },
    "./_source-text": {
      "types": "./dist/source-text.d.ts",
      "default": "./dist/source-text.js"
    },
    "./_redirects": {
      "types": "./dist/redirect-translation.d.ts",
      "default": "./dist/redirect-translation.js"
    },
    "./node": {
      "types": "./dist/node/index.d.ts",
      "default": "./dist/node/index.js"
    },
    "./tanstack-query": {
      "types": "./dist/tanstack-query/index.d.ts",
      "default": "./dist/tanstack-query/index.js"
    },
    "./testing": {
      "types": "./dist/testing/index.d.ts",
      "default": "./dist/testing/index.js"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "build": "rm -rf dist && node scripts/builder-schemas.mjs && tsc -p tsconfig.json && node ../../scripts/finish-package.mjs . && cp tanstack-query/README.md dist/tanstack-query/README.md && cp -r schemas dist/schemas && sed 's#\"\\./dist/#\"./#' builders.json > dist/builders.json",
    "prepublishOnly": "echo \"Publish from dist/: pnpm build, then pnpm --dir dist publish\" >&2 && exit 1",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --test --experimental-test-module-mocks tests/*.test.mjs",
    "test:localize": "sh ../origami-ui/tests/acceptance/gate-lock.sh node tests/localize.mjs",
    "test:remembered": "sh ../origami-ui/tests/acceptance/gate-lock.sh node tests/remembered.mjs"
  },
  "dependencies": {
    "@angular-devkit/architect": "0.2202.6",
    "chokidar": "5.0.0",
    "typescript": "6.0.3",
    "ws": "8.21.3"
  },
  "devDependencies": {
    "@angular/build": "22.3.0",
    "@angular/cli": "22.3.0",
    "@angular/common": "22.3.0",
    "@angular/compiler": "22.3.0",
    "@angular/compiler-cli": "22.3.0",
    "@angular/core": "22.3.0",
    "@angular/localize": "22.3.0",
    "@angular/platform-browser": "22.3.0",
    "@angular/router": "22.3.0",
    "@loozo/angular-router": "workspace:*",
    "@tanstack/angular-query": "5.108.4",
    "@types/node": "24.13.3",
    "@types/ws": "8.18.1",
    "happy-dom": "20.13.2",
    "playwright": "1.63.0",
    "vitest": "4.1.10"
  },
  "peerDependencies": {
    "@angular/build": "~22.3.0",
    "@angular/common": "^22.0.0",
    "@angular/core": "^22.0.0",
    "@angular/router": "^22.0.0",
    "@loozo/angular-router": "0.1.0",
    "@tanstack/angular-query": "^5.0.0",
    "rxjs": "^7.8.2"
  },
  "peerDependenciesMeta": {
    "@tanstack/angular-query": {
      "optional": true
    }
  },
  "builders": "./builders.json"
}
