{
  "name": "@loozo/angular-launch",
  "version": "0.0.0",
  "description": "Typed queries, mutations and declared errors on Angular's native router, HTTP and SSR pipeline.",
  "license": "MIT",
  "files": [
    "dist",
    "README.md"
  ],
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/client.d.ts",
      "default": "./dist/client.js"
    },
    "./server": {
      "types": "./dist/server/index.d.ts",
      "default": "./dist/server/index.js"
    },
    "./_generated": {
      "types": "./dist/generated.d.ts",
      "default": "./dist/generated.js"
    },
    "./generation": {
      "types": "./dist/generation/index.d.ts",
      "node": "./dist/generation/index.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --test tests/*.test.mjs"
  },
  "dependencies": {
    "@loozo/angular-router": "workspace:*",
    "typescript": "6.0.3"
  },
  "devDependencies": {
    "@angular/common": "22.1.5",
    "@angular/compiler": "22.1.5",
    "@angular/core": "22.1.5",
    "@types/node": "24.13.3",
    "playwright": "1.63.0"
  },
  "peerDependencies": {
    "@angular/common": "^22.0.0",
    "@angular/core": "^22.0.0",
    "rxjs": "^7.8.2"
  }
}
