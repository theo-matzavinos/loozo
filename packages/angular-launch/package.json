{
  "name": "@loozo/angular-launch",
  "version": "0.0.1",
  "description": "Typed queries, mutations and declared errors on Angular's native router, HTTP and SSR pipeline.",
  "bugs": "https://github.com/theo-matzavinos/loozo/issues",
  "license": "MIT",
  "author": "Theophilos Matzavinos",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/theo-matzavinos/loozo.git",
    "directory": "packages/angular-launch"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./server": {
      "types": "./dist/server/index.d.ts",
      "default": "./dist/server/index.js"
    },
    "./_server": {
      "types": "./dist/server/generated.d.ts",
      "default": "./dist/server/generated.js"
    },
    "./_generated": {
      "types": "./dist/generated.d.ts",
      "default": "./dist/generated.js"
    },
    "./generation": {
      "types": "./dist/generation/index.d.ts",
      "node": "./dist/generation/index.js"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.json && node ../../scripts/finish-package.mjs .",
    "prepublishOnly": "echo \"Publish from dist/: pnpm build, then pnpm --dir dist publish\" >&2 && exit 1",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --test tests/*.test.mjs"
  },
  "dependencies": {
    "typescript": "6.0.3"
  },
  "devDependencies": {
    "@angular/common": "22.2.2",
    "@angular/compiler": "22.2.2",
    "@angular/core": "22.2.2",
    "@loozo/angular-router": "workspace:*",
    "@types/node": "24.13.3",
    "playwright": "1.63.0"
  },
  "peerDependencies": {
    "@angular/common": "^22.0.0",
    "@angular/core": "^22.0.0",
    "@loozo/angular-router": "0.0.3",
    "rxjs": "^7.8.2"
  }
}
