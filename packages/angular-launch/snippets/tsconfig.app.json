{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "skipLibCheck": true,
    "lib": ["ES2024", "DOM"],
    "types": []
  },
  "angularCompilerOptions": { "strictTemplates": true },
  "include": ["src/**/*.ts", "generated/**/*.ts"],
  "exclude": ["src/**/*.spec.ts"]
}
