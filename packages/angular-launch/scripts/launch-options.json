{
  "$comment": "Launch generation options merged into schemas/application.json by builder-schemas.mjs.",
  "properties": {
    "tsconfig": {
      "type": "string",
      "minLength": 1
    },
    "scanDirectories": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "outDirectory": {
      "type": "string",
      "minLength": 1
    },
    "tanstackQuery": {
      "type": "boolean",
      "default": false
    },
    "check": {
      "type": "boolean",
      "default": false
    }
  },
  "required": ["tsconfig", "scanDirectories", "outDirectory"]
}
