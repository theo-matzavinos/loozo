{
  "version": 1,
  "cli": { "analytics": false },
  "projects": {
    "docs": {
      "projectType": "application",
      "root": "",
      "sourceRoot": "src",
      "architect": {
        "build": {
          "builder": "@loozo/angular-router:application",
          "options": {
            "tsconfig": "tsconfig.routes.json",
            "scanDirectories": ["src/routes"],
            "outDirectory": "generated",
            "browser": "src/main.ts",
            "server": "src/main.server.ts",
            "outputMode": "static",
            "index": "src/index.html",
            "tsConfig": "tsconfig.app.json",
            "outputPath": "dist/docs",
            "styles": ["src/styles.css"]
          },
          "configurations": {
            "production": {
              "baseHref": "/loozo/",
              "budgets": [{ "type": "initial", "maximumWarning": "500kB", "maximumError": "1MB" }]
            },
            "development": {
              "optimization": false,
              "extractLicenses": false,
              "sourceMap": true
            },
            "check": { "check": true }
          },
          "defaultConfiguration": "production"
        },
        "serve": {
          "builder": "@loozo/angular-router:serve",
          "options": { "buildTarget": "docs:build:development" }
        }
      }
    }
  }
}
