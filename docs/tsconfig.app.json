{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "skipLibCheck": true,
    "experimentalDecorators": true,
    "lib": ["ES2022", "DOM"],
    "types": [],
    "outDir": "out-tsc"
  },
  "angularCompilerOptions": { "strictTemplates": true },
  "files": ["src/main.ts", "src/main.server.ts"],
  "include": ["src/**/*.ts", "generated/**/*.ts"]
}
